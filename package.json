{
  "name": "template-react-spa-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "start": "vite --config config/vite.config.ts",
    "build": "tsc && vite build --config config/vite.config.ts",
    "lint": "eslint . --config config/eslint.config.js --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --config config/vite.config.ts",
    "test": "vitest --config config/vitest.config.ts",
    "codegen": "graphql-codegen --config src/graphql/codegen.ts",
    "codegen:watch": "graphql-codegen --config src/graphql/codegen.ts --watch"
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/react-router": "^1.170.45",
    "graphql": "^16.14.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/near-operation-file-preset": "^5.2.3",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-codegen/typescript-react-apollo": "^5.0.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "lodash@<4.18.0": "^4.18.0",
      "immutable@<3.8.4": "^3.8.4",
      "@graphql-tools/utils@<12.0.1": "^13.1.1"
    }
  }
}